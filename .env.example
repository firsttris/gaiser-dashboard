# Public — Vite exposes VITE_-prefixed vars to the browser bundle.
# Safe to expose: Row Level Security in Postgres is what actually protects the data.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only — NEVER prefix with VITE_. Only import from *.server.ts modules.
# Bypasses Row Level Security entirely, treat like a root password.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Used to encrypt/sign the httpOnly session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=
